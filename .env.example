APP_NAME=Project List
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Prefer this for runtime database connection
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/projects

# Legacy fallback variables used by current app default (keep commented
# because pydantic-settings may reject extra keys in strict mode):
# password=postgres
# host=db
# port=5432
# database=projects

# For pydantic list parsing use JSON array
CORS_ORIGINS=["http://127.0.0.1:5500","http://localhost:5500","http://127.0.0.1:8080","http://localhost:8080"]
CORS_ORIGIN_REGEX=^https?://(localhost|127(?:\\.\\d{1,3}){3}|192\\.168(?:\\.\\d{1,3}){2}|10(?:\\.\\d{1,3}){3}|172\\.(?:1[6-9]|2\\d|3[0-1])(?:\\.\\d{1,3}){2})(?::\\d+)?$

STATIC_DIR=static
IMAGE_DIR=static/images
